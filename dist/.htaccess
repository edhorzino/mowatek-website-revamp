# Apache hosting (cPanel etc.). Ignored by other servers.
ErrorDocument 404 /404.html
DirectoryIndex index.html
<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; font-src 'self'; media-src 'self'; connect-src 'self'; form-action 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set X-Frame-Options "DENY"
</IfModule>
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteCond %{THE_REQUEST} \s/+\S*\.html(?:[?\s]) [NC]
RewriteRule ^water-treatment\.html$ /water-treatment/ [R=301,L]
RewriteCond %{THE_REQUEST} \s/+\S*\.html(?:[?\s]) [NC]
RewriteRule ^waste-water-sewage-treatment\.html$ /wastewater-effluent-treatment/ [R=301,L]
RewriteRule ^waste-water-sewage-treatment/?$ /wastewater-effluent-treatment/ [R=301,L]
RewriteCond %{THE_REQUEST} \s/+\S*\.html(?:[?\s]) [NC]
RewriteRule ^wastewater-effluent-treatment\.html$ /wastewater-effluent-treatment/ [R=301,L]
RewriteCond %{THE_REQUEST} \s/+\S*\.html(?:[?\s]) [NC]
RewriteRule ^solid-waste-management\.html$ /services/ [R=301,L]
RewriteRule ^solid-waste-management/?$ /services/ [R=301,L]
RewriteCond %{THE_REQUEST} \s/+\S*\.html(?:[?\s]) [NC]
RewriteRule ^consulting\.html$ /consulting/ [R=301,L]
RewriteCond %{THE_REQUEST} \s/+\S*\.html(?:[?\s]) [NC]
RewriteRule ^training\.html$ /training/ [R=301,L]
RewriteCond %{THE_REQUEST} \s/+\S*\.html(?:[?\s]) [NC]
RewriteRule ^supply-installation-maintenance\.html$ /procurement-maintenance/ [R=301,L]
RewriteRule ^supply-installation-maintenance/?$ /procurement-maintenance/ [R=301,L]
RewriteCond %{THE_REQUEST} \s/+\S*\.html(?:[?\s]) [NC]
RewriteRule ^procurement-maintenance\.html$ /procurement-maintenance/ [R=301,L]
RewriteCond %{THE_REQUEST} \s/+\S*\.html(?:[?\s]) [NC]
RewriteRule ^about\.html$ /about/ [R=301,L]
RewriteCond %{THE_REQUEST} \s/+\S*\.html(?:[?\s]) [NC]
RewriteRule ^services\.html$ /services/ [R=301,L]
RewriteCond %{THE_REQUEST} \s/+\S*\.html(?:[?\s]) [NC]
RewriteRule ^projects\.html$ /projects/ [R=301,L]
RewriteCond %{THE_REQUEST} \s/+\S*\.html(?:[?\s]) [NC]
RewriteRule ^faq\.html$ /faq/ [R=301,L]
RewriteCond %{THE_REQUEST} \s/+\S*\.html(?:[?\s]) [NC]
RewriteRule ^contact\.html$ /contact/ [R=301,L]
RewriteCond %{THE_REQUEST} \s/+\S*\.html(?:[?\s]) [NC]
RewriteRule ^privacy\.html$ /privacy/ [R=301,L]
RewriteCond %{THE_REQUEST} \s/+\S*\.html(?:[?\s]) [NC]
RewriteRule ^index\.html$ / [R=301,L]
RewriteRule ^consultancy-services/?$ /consulting/ [R=301,L]
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
</IfModule>
